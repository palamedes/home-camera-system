# Environment for the Caddy HTTPS front (sentry-tls.service), DNS-01 variant.
# ---------------------------------------------------------------------------
# Copy to ~/.config/sentry-tls.env, fill in your real values, then:
#     chmod 600 ~/.config/sentry-tls.env
# Keep it OUT of git — it holds a DNS-provider API key. The systemd unit loads
# it via EnvironmentFile, and Caddyfile.public-dns.example reads these vars, so
# no secret or personal domain ever lands in a committed file.

# The public hostname clients use. Add a DNS A record for it pointing at this
# box's LAN IP (e.g. 192.168.1.50). It resolves to a private address, so it
# only works inside your LAN — never reachable from the internet.
SENTRY_DOMAIN=home.example.com

# DNS provider API credentials. This example is Namecheap
# (Profile -> Tools -> Namecheap API Access): the account must be API-eligible,
# and the box's WAN IP must be added to Namecheap's API allowlist. If your WAN
# IP changes, renewals fail until you update that allowlist.
NAMECHEAP_API_USER=your_namecheap_username
NAMECHEAP_API_KEY=your_namecheap_api_key
